# Copia este archivo como .env y llena los valores.
# El .env NUNCA se sube al repositorio (está en .gitignore).

# --- Skydropx (hPanel de Skydropx › API) ---
SKYDROPX_API_KEY=
SKYDROPX_API_SECRET=
# Dirección de origen guardada en Skydropx (sucursal verificada con Interrapidísimo).
# Se obtiene en GET /api/v1/address_templates
SKYDROPX_ORIGEN_ID=

# --- OpenAI (para leer los pedidos con IA) ---
OPENAI_API_KEY=

# --- Acceso al panel ---
PANEL_USUARIO=admin
# Genera el hash con:
#   python -c "from werkzeug.security import generate_password_hash as h; print(h(input('Contraseña: ')))"
PANEL_PASSWORD_HASH=

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Impresora en red (solo sirve en la red local de la bodega) ---
IMPRESORA_URL=http://192.168.1.17:631/ipp/print
